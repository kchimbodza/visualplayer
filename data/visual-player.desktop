[Desktop Entry]
Type=Application
Name=Visual Player
GenericName=Media Player
Comment=Play HDR video and Dolby Atmos audio, and see exactly how it's playing
Icon=visual-player
# %F passes local file paths. For network shares opened in GNOME Files,
# that's the mounted path, which mpv can play directly.
Exec=vplay -- %F
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;movie;player;hdr;atmos;dolby;mpv;
MimeType=video/x-matroska;video/mp4;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/mp2t;video/x-m4v;video/ogg;video/x-flv;audio/x-matroska;
StartupWMClass=visual-player
